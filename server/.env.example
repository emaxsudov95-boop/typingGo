# Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
# .env faylini hech qachon GitHub'ga yuklamang.

# Backend porti
PORT=4000

# MongoDB Atlas ulanish manzili (Atlas → Connect → Drivers)
# Masalan: mongodb+srv://<user>:<parol>@<klaster>.mongodb.net/typinggo?retryWrites=true&w=majority
MONGODB_URI=

# JWT uchun uzun tasodifiy maxfiy qator (kamida 16 belgi)
# Yaratish: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Ruxsat etilgan frontend manzil(lar)i, vergul bilan
CLIENT_ORIGIN=http://localhost:5173
